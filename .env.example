# Copie vers .env en local, ou colle les clés dans Railway / Hetzner.

DEBUG=False
SECRET_KEY=change-moi-avec-une-cle-longue-et-aleatoire
ALLOWED_HOSTS=ton-domaine.com,www.ton-domaine.com
CSRF_TRUSTED_ORIGINS=https://ton-domaine.com,https://www.ton-domaine.com
SITE_URL=https://ton-domaine.com
TIME_ZONE=Europe/Paris

# PostgreSQL — Railway ajoute DATABASE_URL avec le plugin Postgres.
# Hetzner / Docker : postgres://portfolio:MOTDEPASSE@db:5432/portfolio
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/portfolio

SERVE_MEDIA=True
MEDIA_ROOT=

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

ADMIN_URL_PATH=n3xus-k7m2/
ADMIN_UNLOCK_TOKEN=change-moi-jeton-atelier
ADMIN_LOGIN_ATTEMPTS=3
ADMIN_LOCK_MINUTES=30
ADMIN_USERNAME=arsene
ADMIN_PASSWORD=change-moi-mot-de-passe-atelier
ADMIN_EMAIL=arsene@example.com

WEB_WORKERS=3
PORT=8000

# Hetzner docker-compose
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-moi-mot-de-passe-postgres
